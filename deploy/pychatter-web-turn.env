# Environment file for pychatter-web TURN settings
# Copy to /etc/pychatter/pychatter-web-turn.env and edit values.

PYCHATTER_TURN_URL=turn:your-domain.com:3478
PYCHATTER_TURN_USERNAME=pychatter
PYCHATTER_TURN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Optional: use PYCHATTER_TURN_PASSWORD only if coturn is configured with a
# static user instead of use-auth-secret/static-auth-secret.
#
# Optional: provide full ICE servers list instead of simple TURN vars.
# PYCHATTER_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-domain.com:3478","username":"pychatter","credential":"CHANGE_ME_STRONG_PASSWORD"}]
