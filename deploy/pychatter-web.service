[Unit]
Description=PyChatter Web Bridge and Static Host
After=network-online.target pychatter-server.service
Wants=network-online.target
Requires=pychatter-server.service

[Service]
Type=simple
User=pychatter
WorkingDirectory=/opt/pychatter
ExecStart=/usr/bin/bash /opt/pychatter/scripts/run_web.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
